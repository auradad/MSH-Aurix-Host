#!/bin/bash
# Aurix Host - MSH boot.
# Baked into the Docker image at /usr/local/bin/msh-boot, OUTSIDE the server owner's /home/container.
# The egg's startup command is the single word `msh-boot`, which the server owner cannot edit, so there is
# no file in their reach that lets them bypass MSH. On every start this pulls the host's current MSH.jar into
# a private path (/tmp, also outside /home/container) and runs it; if the download fails, it runs the copy
# baked into the image. Either way MSH - not the owner's files - is what launches.
set -u
cd /home/container || exit 1

BAKED=/opt/msh/MSH.jar       # read-only copy shipped in the image
JAR="${BAKED}"

# Prefer the host's latest MSH.jar (so you can push updates by replacing the release asset).
if curl -fsSL --retry 2 --connect-timeout 10 --max-time 120 -o /tmp/msh.jar "${MSH_DOWNLOAD_URL:-}" && [ -s /tmp/msh.jar ]; then
  # Sanity check it is really a jar (ZIP magic) before trusting it.
  if head -c2 /tmp/msh.jar | grep -q PK; then
    JAR=/tmp/msh.jar
  fi
fi

exec java -Xms16M -Xmx64M -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -jar "${JAR}"
